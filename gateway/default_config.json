{
  "kb_path": "data/knowledge.json",
  "timeout_sec": 60,
  "providers": [
    {
      "name": "custom",
      "type": "custom",
      "model": "custom-1",
      "no_key": true,
      "priority": 1,
      "options": {
        "threshold": 0.8,
        "web_search": true,
        "search_engines": [
          "duckduckgo"
        ],
        "max_results": 5,
        "simulations": 5000,
        "learn_from_peers": true,
        "peer_ttl_days": 30,
        "market": true,
        "weather": true,
        "default_city": "Jakarta"
      }
    },
    {
      "name": "gemini",
      "type": "gemini",
      "model": "gemini-3.8-flash",
      "keys_env": "GEMINI_API_KEYS",
      "priority": 2
    },
    {
      "name": "groq",
      "type": "openai_compat",
      "base_url": "https://api.groq.com/openai/v1",
      "model": "openai/gpt-oss-20b",
      "keys_env": "GROQ_API_KEYS",
      "priority": 3
    },
    {
      "name": "openrouter",
      "type": "openai_compat",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "openrouter/free",
      "keys_env": "OPENROUTER_API_KEYS",
      "priority": 4
    },
    {
      "name": "mistral",
      "type": "openai_compat",
      "base_url": "https://api.mistral.ai/v1",
      "model": "mistral-small-latest",
      "keys_env": "MISTRAL_API_KEYS",
      "priority": 5
    },
    {
      "name": "ollama",
      "type": "openai_compat",
      "base_url": "http://localhost:11434/v1",
      "model": "llama3.2",
      "no_key": true,
      "priority": 6,
      "disabled": true
    },
    {
      "name": "claude",
      "type": "anthropic",
      "model": "claude-haiku-5-5",
      "keys_env": "ANTHROPIC_API_KEYS",
      "priority": 9
    },
    {
      "name": "gpt",
      "type": "openai",
      "model": "gpt-4o-mini",
      "keys_env": "OPENAI_API_KEYS",
      "priority": 10
    }
  ]
}
