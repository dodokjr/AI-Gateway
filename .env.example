# Salin ke .env lalu isi. Boleh banyak key per provider, pisahkan dengan koma.
# Provider tanpa key otomatis dilewati.

# Kunci untuk mengamankan gateway ini (sangat disarankan)
GATEWAY_KEY=ganti-dengan-rahasia-panjang

# --- Gratis (ada kuota harian/menit) ---
GEMINI_API_KEYS=          # https://aistudio.google.com/apikey
GROQ_API_KEYS=            # https://console.groq.com/keys
OPENROUTER_API_KEYS=      # https://openrouter.ai/keys (pakai model berakhiran :free)
MISTRAL_API_KEYS=         # https://console.mistral.ai/

# --- Berbayar (opsional, dipakai sebagai cadangan terakhir) ---
ANTHROPIC_API_KEYS=
OPENAI_API_KEYS=

# --- Penyimpanan data training (WAJIB untuk Vercel/Netlify) ---
# Buat database Redis gratis di https://upstash.com lalu salin REST URL & token.
# (Di Vercel: Marketplace > Upstash Redis; variabel KV_REST_API_URL/TOKEN juga dikenali.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
